<template>
	<view class="hya-picker">
		<view class="hya-picker-main" :style="screenHeight" v-if="show === true">
			<view class="hya-picker-main-content">
				<view class="main-content">
					<view class="main-content-title">
						<text class="main-content-title-quit" @click="goQuit">取消</text>
						<text class="main-content-title-confirm" @click="goConfirm">确认</text>
					</view>
					<picker-view class="main-content-picker" style="width: 100%; height: 220px"
						indicator-style="height:36px;" :value="nowValue" @change="pickerValueChange">
						<picker-view-column>
							<view class="main-content-picker-item" v-for="(item, index) in setting.columns"
								:key="index">
								<view class="item-content">
									<text class="item-content-text" v-text="item.label"></text>
								</view>
							</view>
						</picker-view-column>
					</picker-view>
				</view>
			</view>
		</view>
		<view :class="setting.titleType==1?'hya-picker-back':'hya-picker-bottom-line'" class="hya-picker-show"
			:style="formStyle">
			<view :class="setting.titleType==3?'hya-picker-show-title-two':'hya-picker-show-title-one'">
				<hya-icon v-if="setting.titleType!=3" :name="setting.titleIcon==null?'yingyong':setting.titleIcon"
					color="#000000" size="14" />
				<text class="title-two-text" v-if="setting.titleType==3" v-text="setting.title"></text>
			</view>
			<view class="hya-picker-show-content-one" v-if="setting.titleType!=3" @click="goShow">
				<view class="one-view">
					<text class="one-view-unselected" v-show="setting.value==''"
						v-text="setting.placeholder==null?'请选择':setting.placeholder"></text>
					<text class="one-view-selected" v-show="setting.value!=''&&item.label==selectedShow"
						v-text="item.label" v-for="(item,index) in setting.columns" :key="index"></text>
				</view>
			</view>
			<view class="hya-picker-show-content-two" v-if="setting.titleType==3" @click="goShow">
				<view class="two-view">
					<text class="two-view-unselected" v-show="setting.value==''"
						v-text="setting.placeholder==null?'请选择':setting.placeholder"></text>
					<text class="two-view-selected" v-show="setting.value!=''&&item.label==selectedShow"
						v-text="item.label" v-for="(item,index) in setting.columns" :key="index"></text>
				</view>
			</view>
			<view class="hya-picker-show-end" @click="goShow">
				<hya-icon name="right-1-copy" :color="setting.disabled==true?'#bfbfbf':'#000000'" size="14" />
			</view>
		</view>
		<view class="hya-error" :style="formStyle" v-if="setting.errMsg!=''&&setting.errMsg!=null">
			<text :class="setting.titleType==3?'':'hya-error-left'" class="hya-error-text"
				v-text="setting.errMsg"></text>
		</view>
	</view>
</template>

<script lang="uts">
	import HyaIcon from '../hya-icon/hya-icon.uvue';
	import type { FormType, PickerBack, ColumnType } from '../../libs/model/index.uts';
	import type { PropType } from 'vue';
	export default {
		name: "hya-picker",
		computed: {
			screenHeight() : string {
				return `height: ${uni.getWindowInfo().windowHeight}px`;
			},
			formStyle() : string {
				return `width: ${uni.getWindowInfo().windowWidth - 24}px`;
			}
		},
		components: {
			HyaIcon
		},
		props: {
			show: {
				type: Boolean,
				default: false
			},
			showIndex: {
				type: Number,
				default: -1
			},
			setting: {
				type: Object as PropType<FormType>,
				required: true,
				default: () : FormType => ({
					type: 'input',
					title: '',
					key: '',
					value: '',
					titleType: 1,
					titleIcon: 'yingyong',
					required: false,
					rules: [],
					disabled: false,
					errMsg: '',
					columns: [],
					pickerShow: false,
					pickerValue: [0]
				} as FormType)
			}
		},
		watch: {
			setting: {
				handler(n : FormType) {
					if (n.value != '') {
						let tempColumns = n.columns as Array<ColumnType> | null;
						if (tempColumns != null) {
							for (let i = 0; i < tempColumns.length; i++) {
								if (n.value === tempColumns[i].value) {
									this.nowValue = [i];
									this.selectedShow = tempColumns[i].label;
									break;
								}
							}
						}
					} else {
						this.nowValue = [0];
					}
				},
				immediate: true
			},
			show(n : boolean) {
				if (n === true) {
					let temp = this.setting.pickerValue as Array<number> | null;
					if (temp != null) {
						this.nowValue = this.setting.pickerValue as Array<number>;
					}
				}
			}
		},
		data() {
			return {
				selectedShow: '' as string,
				nowValue: [0] as Array<number>,
				tempValue: [0] as Array<number>,
			};
		},
		methods: {
			goShow() {
				if (this.setting.disabled !== true) {
					this.$emit('showChange', { show: true, index: this.showIndex } as PickerBack);
				}
			},
			goQuit() {
				this.goValidate();
				this.$emit('showChange', { show: false, index: this.showIndex } as PickerBack);
			},
			goConfirm() {
				this.setting.pickerValue = this.tempValue;
				let tempColumns = this.setting.columns as Array<ColumnType> | null;
				if (tempColumns != null) {
					this.setting.value = '';
					this.setting.value = tempColumns[this.tempValue[0]].value;
					this.selectedShow = tempColumns[this.tempValue[0]].label;
				}
				this.goQuit();
			},
			pickerValueChange(e : PickerViewChangeEvent) {
				this.tempValue = e.detail.value;
			},
			goValidate() {
				if (this.setting.required === true) {
					if (this.setting.value == '' || this.setting.value == null) {
						this.setting.errMsg = `请选择${this.setting.title}`;
						return;
					} else {
						this.setting.errMsg = '';
					}
				}
			}
		}
	}
</script>

<style lang="scss">
	.hya-picker {
		width: 100%;

		.hya-picker-main {
			width: 100%;
			position: fixed;
			top: 0;
			left: 0;
			z-index: 99;
			background-color: rgba(0, 0, 0, 0.5);

			.hya-picker-main-content {
				width: 100%;
				height: 100%;
				position: relative;

				.main-content {
					width: 100%;
					height: 256px;
					background-color: #fff;
					border-radius: 16px 16px 0 0;
					position: absolute;
					bottom: 0;
					left: 0;

					.main-content-title {
						margin-top: 16px;
						height: 20px;
						display: flex;
						flex-direction: row;
						align-items: center;
						justify-content: space-between;

						.main-content-title-quit {
							font-size: 12px;
							padding: 0 16px;
							color: #9a9998;
						}

						.main-content-title-confirm {
							font-size: 12px;
							padding: 0 16px;
							color: #3c9cff;
						}
					}

					.main-content-picker {
						.main-content-picker-item {
							height: 36px;

							.item-content {
								height: 36px;
								width: 96%;
								margin: 0 auto;
								display: flex;
								justify-content: center;
								align-items: center;
								flex-direction: row;

								.item-content-text {
									width: 100%;
									text-align: center;
									height: 36px;
									line-height: 36px;
									font-size: 14px;
									text-overflow: ellipsis;
								}
							}
						}
					}
				}
			}
		}

		.hya-picker-back {
			background: rgba(0, 0, 0, 0.04);
			border-radius: 23px;
		}

		.hya-picker-bottom-line {
			border-bottom: 1px solid rgba(50, 125, 255, 0.1);
		}

		.hya-picker-show {
			margin: 0 auto;
			display: flex;
			flex-direction: row;
			flex-wrap: wrap;

			.hya-picker-show-title-one {
				margin-left: 14px;
				width: 16px;
				height: 46px;
				justify-content: flex-end;
				display: flex;
				align-items: center;
				flex-direction: row;
				margin-right: -6px;
			}

			.hya-picker-show-title-two {
				width: 100%;

				.title-two-text {
					font-size: 14px;
					font-weight: 700;
				}
			}

			.hya-picker-show-content-one {
				flex: 1;
				margin: 0 12px 0 18px;
				flex-direction: row;
				display: flex;
				align-items: center;

				.one-view {
					width: 100%;
					height: 46px;
					display: flex;
					align-items: center;
					justify-content: center;
					flex-wrap: nowrap;
					flex-shrink: 1;

					.one-view-unselected {
						width: 100%;
						height: 46px;
						line-height: 46px;
						font-size: 14px;
						color: #bfbfbf;
						letter-spacing: 0.5px;
						text-overflow: ellipsis;
					}

					.one-view-selected {
						width: 100%;
						height: 46px;
						line-height: 46px;
						font-size: 14px;
						color: #333;
						text-overflow: ellipsis;
					}
				}
			}

			.hya-picker-show-content-two {
				flex: 1;
				margin: 0 12px 0 0;
				flex-direction: row;
				display: flex;
				align-items: center;

				.two-view {
					width: 100%;
					height: 46px;
					display: flex;
					align-items: center;
					flex-direction: row;

					.two-view-unselected {
						width: 100%;
						font-size: 14px;
						height: 46px;
						line-height: 46px;
						color: #bfbfbf;
						letter-spacing: 0.5px;
						overflow: hidden;
						text-overflow: ellipsis;
					}

					.two-view-selected {
						width: 100%;
						font-size: 14px;
						height: 46px;
						line-height: 46px;
						color: #333;
						overflow: hidden;
						text-overflow: ellipsis;
					}
				}
			}

			.hya-picker-show-end {
				margin-right: 14px;
				width: 16px;
				height: 46px;
				justify-content: flex-end;
				display: flex;
				align-items: center;
				flex-direction: row;
			}
		}

		.hya-error {
			margin: 0 auto;

			.hya-error-text {
				margin-top: 6px;
				font-weight: 400;
				font-size: 12px;
				color: red;
			}

			.hya-error-left {
				padding-left: 12px;
			}
		}
	}
</style>