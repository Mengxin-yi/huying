					input3: '',
					input4: '',
					input5: '',
					input6: '',
					input7: '',
					input8: '',
				},
				inputs3: {
					input1: '',
					input2: '',
					input3: '',
					input4: '',
					input5: '',
				},
				inputs4: {
					input1: '',
					input2: '',
					input3: '',
					input4: '',
					input5: '',
				},
				inputs5: {
					input1: '',
					input2: '',
					input3: '',
					input4: '',
					input5: '',
					input6: '',
					input7: '',
				},
				readOnly: true,
				current: 0,
				items: ['输入', '模版'],
				placeholderStyle: "color:grey;font-size:14px",
				placeholderStyle1: "color:grey;font-size:12px",
				content: '',
				type: 'center',
				form: {
					type: '',
					content: '',
				},
				formTitle: '',
				data: {

				},
				imageList: [],
				sourceTypeIndex: 2,
				sourceType: ['拍照', '相册', '拍照或相册'],
				sizeTypeIndex: 2,
				sizeType: ['压缩', '原图', '压缩或原图'],
				countIndex: 8,
				count: [1, 2, 3, 4, 5, 6, 7, 8, 9],
				data_type_list: [{
						text: '招标',
						value: 'bid'
					},
					{
						text: '招聘',
						value: 'job'
					},
					{
						text: '通知',
						value: 'notice'
					},
					{
						text: '项目',
						value: 'project'
					},
					{
						text: '会议',
						value: 'meeting'
					}
				],
				enableDel: true,
				enableAdd: true,
				tagList: [],
				pageElement: pageUtil.pageElement(),
			}
		},
		onLoad() {
			// uni.hideTabBar();
		},
		computed: {
			startDate() {
				return this.getDate('start');
			},
			endDate() {
				return this.getDate('end');
			}
		},
		onShow() {
			if (JSON.parse(uni.getStorageSync('profile'))['user_type'] === '企事业单位') {
				this.range = [{
						value: '招标',
						text: "招标"
					},
					{
						value: '招聘',
						text: "招聘"
					},
					{
						value: '通知',
						text: "通知"
					},
					{
						value: '项目',
						text: "项目"
					},
					{
						value: '会议',
						text: "会议"
					},
				]
			} else {
				this.range = [{
						value: '招标',
						text: "招标"
					},
					{
						value: '招聘',
						text: "招聘"
					},
					{
						value: '项目',
						text: "项目"
					},
					{
						value: '会议',
						text: "会议"
					},
				]
			}
		},
		onUnload() {
			this.imageList = [];
			this.sourceTypeIndex = 2;
			this.sourceType = ['拍照', '相册', '拍照或相册'];
			this.sizeTypeIndex = 2;
			this.sizeType = ['压缩', '原图', '压缩或原图'];
			this.countIndex = 8;
			// uni.showTabBar();
		},
		mounted() {
			document.querySelector('input').addEventListener('focus', function() {
				setTimeout(function() {
					document.body.scrollTop = document.body.scrollHeight;
				}, 100);
			});
			// pageUtil.checkWechatAll();
		},
		methods: {
			selectOne() {
				this.isshowfdsl = false;
			},
			selectTwo() {
				this.isshowfdsl = true;
			},
			xzmba() {
				this.ismb = false;
			},
			xzmb() {
				console.log('选择模版')
				this.ismb = true;
				this.$refs.share.open()
			},
			getDate(type) {
				const date = new Date();
				let year = date.getFullYear();
				let month = date.getMonth() + 1;
				let day = date.getDate();

				if (type === 'start') {
					year = year - 60;
				} else if (type === 'end') {
					year = year + 2;
				}
				month = month > 9 ? month : '0' + month;
				day = day > 9 ? day : '0' + day;
				return `${year}-${month}-${day}`;
			},
			//
			onEditorReady() {
				// #ifdef MP-BAIDU
				this.editorCtx = requireDynamicLib('editorLib').createEditorContext('editor');
				// #endif

				// #ifdef APP-PLUS || MP-WEIXIN || H5
				uni.createSelectorQuery().select('#editor').context((res) => {
					res.context.setContents({
						html: '<h1>大标题</h1><p>正文内容</p> 	<uni-easyinput type="text"  placeholder="请输入姓名" />'
					});

					// this.editorCtx.html('<h1>大标题</h1><p>正文内容</p>')
				}).exec()
				// #endif

				// this.editorCtx.setContents({
				//     html: '<h1>大标题</h1><p>正文内容</p>'
				// });
			},
			format(e) {
				let {
					name,
					value
				} = e.target.dataset
				if (!name) return
				// console.log('format', name, value)
				this.editorCtx.format(name, value)
			},
			onStatusChange(e) {
				const formats = e.detail
				this.formats = formats
			},
			change(e) {
				if (e == '') {
					this.ismb = false;
				}
			},
			toggle(type) {
				this.type = type
				// open 方法传入参数 等同在 uni-popup 组件上绑定 type属性
				this.$refs.popup.open(type)
			},
			handleReset() {
				this.form = {};
				this.imageList = [];
			},
			toType(sre) {
				switch (sre) {
					case 'bid':
						return '招标'
						break;
					case 'job':
						return '招聘'
						break;
					case 'notice':
						return '通知'
						break;
					case 'project':
						return '项目'
						break;
					case 'meeting':
						return '会议'
						break;
					default:
				}
			},
			handleAdd() {
				let that = this;
				var rule = [{
					name: "title",
					checkType: "notnull",
					checkRule: "",
					errorMsg: "请输入标题"
				}, ];
				pageUtil.submitForm(this.form, rule)
					.then(() => {
						var str = '';
						var cont = '';
						if (this.isshowfdsl == true) {
							str = this.form.title + '; ' + this.form.content;
						} else {
							str += this.form.title + '; '
							if (this.form.type !== '') {
								switch (this.form.type) {
									case '招标':
										for (var item in this.inputs1) {
											str += that.inputs1[item]
											cont += (that.ysret1[item]['k'] + that.ysret1[item]['text'] + that.inputs1[
													item] +
												that.ysret1[item]['h'])
										}
										break;
									case '招聘':
										for (var item in this.inputs2) {
											str += that.inputs2[item]
											cont += (that.ysret2[item]['k'] + that.ysret2[item]['text'] + that.inputs2[
													item] +
												that.ysret2[item]['h'])
										}
										break;
									case '通知':
										for (var item in this.inputs3) {
											str += that.inputs3[item]
											cont += (that.ysret3[item]['k'] + that.ysret3[item]['text'] + that.inputs3[
													item] +
												that.ysret3[item]['h'])
										}
										break;
									case '项目':
										for (var item in this.inputs4) {
											str += that.inputs4[item]
											cont += (that.ysret4[item]['k'] + that.ysret4[item]['text'] + that.inputs4[
													item] +
												that.ysret4[item]['h'])
										}
										break;
									case '会议':
										for (var item in this.inputs5) {
											str += that.inputs5[item]
											cont += (that.ysret5[item]['k'] + that.ysret5[item]['text'] + that.inputs5[
													item] +
												that.ysret5[item]['h'])
										}
										break;
									default:
								}
							}
							this.form.content = cont;
						}
						pageUtil.webApi.getWordCheck({
								txt: str
							})
							.then(res => {
								if (res.is_contain === 0) {
									this.handleAddHelp();
								} else {
									if (res.words && res.words.length >= 1) {
										const text = res.words.join(',')
										pageUtil.toast(`您输入的内容包含 ${text} 敏感信息，请检查后再提交`);
									} else {
										pageUtil.toast('您输入的内容包含敏感信息，请检查后再提交');
									}

								}
							})
							.catch(err => {
								pageUtil.toast(err);
							});
					});
			},
			handleAddHelp() {
				if (pageUtil.helper.other.isEmpty(this.form.content) && this.imageList.length === 0) {
					pageUtil.toast('请添加内容或上传图片');
				} else {
					if (this.form.title !== '') {
						if (this.form.type == '') {
							this.form.title = this.form.title
						} else {
							this.form.title = ('【' + this.form.type + '】' + this.form.title)
						}
					}
					var param = Object.assign({}, this.form);
					console.log('||', this.imageList)
					param.files = this.imageList.filter(e => e.indexOf('blob:') > -1).map(m => {
						var n = {
							name: 'files',
							uri: m
						};
						return n;
					});
					pageUtil.webApi.addPublish(param)
						.then(res => {
							pageUtil.toast('提交成功').then(res => {
								pageUtil.goBack();
							});
							pageUtil.markState('publish/add');
						})
						.catch(err => {
							pageUtil.toast(err);
						});
				}

			},
			sourceTypeChange: function(e) {
				this.sourceTypeIndex = parseInt(e.detail.value)
			},
			sizeTypeChange: function(e) {
				this.sizeTypeIndex = parseInt(e.detail.value)
			},
			countChange: function(e) {
				this.countIndex = e.detail.value;
			},
			chooseImage: async function() {
				// #ifdef APP-PLUS
				// TODO 选择相机或相册时 需要弹出actionsheet，目前无法获得是相机还是相册，在失败回调中处理
				if (this.sourceTypeIndex !== 2) {
					let status = await this.checkPermission();
					if (status !== 1) {
						return;
					}
				}
				// #endif

				if (this.imageList.length >= 9) {
					let isContinue = await this.isFullImg();
					if (!isContinue) {
						return;
					}
				}
				uni.chooseImage({
					sourceType: sourceType[this.sourceTypeIndex],
					sizeType: sizeType[this.sizeTypeIndex],
					count: this.imageList.length + this.count[this.countIndex] > 9 ? 9 - this.imageList
						.length : this.count[this.countIndex],
					success: (res) => {
						console.log('res', res)
						for (var key in res.tempFiles) {
							var e = res.tempFiles[key];
							if (e.size > pageUtil.constant.imageFileMaxSize) {
								pageUtil.toast('单张图片大小不能超过' + pageUtil.constant.imageFileMaxSizeString);
								return;
							}
						}
						this.imageList = this.imageList.concat(res.tempFilePaths);
					},
					fail: (err) => {
						// console.log("err: ", err);
						// #ifdef APP-PLUS
						if (err['code'] && err.code !== 0 && this.sourceTypeIndex === 2) {
							this.checkPermission(err.code);
						}
						// #endif
						// #ifdef MP
						if (err.errMsg.indexOf('cancel') !== '-1') {
							return;
						}
						uni.getSetting({
							success: (res) => {
								let authStatus = false;
								switch (this.sourceTypeIndex) {
									case 0:
										authStatus = res.authSetting['scope.camera'];
										break;
									case 1:
										authStatus = res.authSetting['scope.album'];
										break;
									case 2:
										authStatus = res.authSetting['scope.album'] && res
											.authSetting['scope.camera'];
										break;
									default:
										break;
								}
								if (!authStatus) {
									uni.showModal({
										title: '授权失败',
										content: 'Hello uni-app需要从您的相机或相册获取图片，请在设置界面打开相关权限',
										success: (res) => {
											if (res.confirm) {
												uni.openSetting()
											}
										}
									})
								}
							}
						})
						// #endif
					}
				})
			},
			isFullImg: function() {
				return new Promise((res) => {
					uni.showModal({
						content: "已经有9张图片了,是否清空现有图片？",
						success: (e) => {
							if (e.confirm) {
								this.imageList = [];
								res(true);
							} else {
								res(false)
							}
						},
						fail: () => {
							res(false)
						}
					})
				})
			},
			previewImage: function(e) {
				var current = e.target.dataset.src
				uni.previewImage({
					current: current,
					urls: this.imageList
				})
			},
			async checkPermission(code) {
				let type = code ? code - 1 : this.sourceTypeIndex;
				let status = permision.isIOS ? await permision.requestIOS(sourceType[type][0]) :
					await permision.requestAndroid(type === 0 ? 'android.permission.CAMERA' :
						'android.permission.READ_EXTERNAL_STORAGE');

				if (status === null || status === 1) {
					status = 1;
				} else {
					uni.showModal({
						content: "没有开启权限",
						confirmText: "设置",
						success: function(res) {
							if (res.confirm) {
								permision.gotoAppSetting();
							}
						}
					})
				}

				return status;
			},
			deleteImage(index) {
				this.imageList.splice(index, 1);
			},
			clickTag: function(e) {
				console.log(e)
			},
			delTag: function(e) {
				console.log(e)
			},
			addTag: function(e) {
				console.log(e)
			}
		}
	}
</script>

