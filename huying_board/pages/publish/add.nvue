			&.reset {
				margin-top: 0rpx;
			}
		}

		.uni-input {
			padding: 0px !important;
			// color: var(--default-color);

			&.content {
				min-height: 160rpx;
				// font-size: 26rpx;
				// color: var(--default-color);
			}
		}

		.cell-pd {
			// padding: 22rpx 30rpx;
		}

		.list-pd {
			margin-top: 0px;
		}

		.uni-uploader__files {
			flex-direction: row;

			.uni-icon {
				color: var(--danger-color);
				position: absolute;
