					<view class="uni-uploader">
						<view class="uni-uploader-head subtitle" style="font-size: 14px;">
							<view class="uni-uploader-title name" style="font-size: 14px;font-weight: 600;">图片内容</view>
							<view class="uni-uploader-info">{{imageList.length}}/9</view>
						</view>
						<view class="uni-uploader-body" style="padding-left: 38px;">
							<view class="uni-uploader__files" style="padding-left:10px">
								<block v-for="(image,index) in imageList" :key="index">
									<view class="uni-uploader__file"
										style="background: #F8F8F8;border:1px solid red !important;">
										<image class="uni-uploader__img" :src="image" :data-src="image"
											@tap="previewImage"></image>
										<view class="uni-icon" @tap="deleteImage(index)">
											&#xe434;</view>
									</view>
								</block>
								<view class="uni-uploader__input-box" style="border:1px solid #D9D9D9">
									<view class="uni-uploader__input" @tap="chooseImage"></view>
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>
		</view>
		<uni-popup ref="share" type="share" safeArea backgroundColor="#E0EDFF" mask-background-color="rgba(0,0,0,0)"
			borderRadius="10px 10px 10px 10px">

		</uni-popup>
		<button style="width:90%;margin: 20px auto;" type="primary" @click="handleAdd">提 交</button>
		<button style="width:90%;margin: 3px auto;background:rgb(222 227 231) !important;border: none !important;"
			type="default" @click="handleReset" class="reset">重 置</button>


	</view>
</template>

<script>
