			padding: 20rpx 20rpx;
		}

		.action {
			display: flex;
			align-items: center;
			justify-content: space-between;
			background-color: #fff;
			color: #6a6a6a;
			padding-bottom: 20rpx;
			border-radius: 8rpx;
			// color: var(--primary-color);

			&>* {}

			uni-button {
				height: 80rpx;
				background-color: #fff;
				color: var(--primary-color);

				uni-text {
					color: var(--primary-color) !important;
				}
			}

			uni-button:after {
				border: none;
			}

			uni-picker {
				flex: 1;
				text-align: center;
			}
		}

		.list-item {
			background-color: #fff;
			margin: 50rpx 0;
			border-radius: 15rpx;

			.content-box {
				position: relative;
				overflow: hidden;
				padding: 0rpx 0rpx;
				border-radius: 8rpx;

				.content-text {
					padding: 40rpx 20rpx;
					// display: inline-block;
