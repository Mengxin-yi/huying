<template>
	<view class="content-inner">
		<view class="uni-padding-wrap uni-common-mt">
			<view class="action">
				<lxCalendar @change="changeCalendar" :date_tip="dateNum" brief></lxCalendar>
			</view>
			<leo-list :show-icon="true" :show-arrow="true" :list="data"></leo-list>
			<view class="uni-loadmore" v-if="showLoadMore">{{loadMoreText}}</view>
			<uni-fab ref="fab" :pattern="pattern" horizontal="right" vertical="bottom" direction="horizontal"
				@fabClick="handleAdd" />
		</view>

		<novice-guidance :step="step"></novice-guidance>
	</view>
</template>
<script>
	import dayjs from 'dayjs'
	import leoList from './leo-list.nvue'
	import pageUtil from '../../common/js/utils/page.js';
	import lxCalendar from '../../components/lx-calendar/lx-calendar.vue';

	export default {
		components: {
			lxCalendar,
			leoList
		},
		data() {
			return {
				query: {
					date: dayjs().format('YYYY-MM-DD'),
					page: 1,
					page_size: 7
				},
				title: '下拉刷新 + 加载更多',
				data: [],
				loadMoreText: "加载中...",
				showLoadMore: false,
				max: 0,
				startDate: '',
				endDate: '',
				date: '',
				current: 3,
				total: 10,
				pageSize: 1,
				show: false,
				isOpened: 'none',
				pattern: {
					color: '#7A7E83',
					backgroundColor: '#fff',
					selectedColor: '#007AFF',
					buttonColor: '#007AFF',
					iconColor: '#fff'
				},
				step: {
					name: 'note/list',
					vueFixes: true,
					guideList: [{
							el: '.action',
							tips: '这里可以选择日期，查看对应日期的日程安排列表',
							next: '下一步',
							part: 'left',
							weixin: {
								grid: {
									top: 'navBarHeight'
								}
							}
						},
						{
							el: '.uni-fab__circle',
							tips: '点击"+"号按钮，可以添加新的日程安排',
							next: '下一步',
							part: 'right',
							weixin: {
								grid: {
									top: 'navBarHeight'
								}
							}
						}
					]
				},
				dateNum: {},
				pageDisplayed: false
			}
		},
		onLoad() {
			this.initData();

		},
		onShow() {
			this.initData();
		},
		onUnload() {
			this.max = 0,
				this.data = [],
				this.loadMoreText = "加载更多",
				this.showLoadMore = false;
		},
		onReachBottom() {
			console.log("onReachBottom");
			// if (this.max > 40) {
			if (this.max <= this.data.length) {
				this.loadMoreText = "没有更多数据!"
				return;
			}
			this.showLoadMore = true;
			setTimeout(() => {
				this.setListData();
			}, 300);
		},
		onPullDownRefresh() {
			console.log('onPullDownRefresh');
			this.query.page = 1;
			this.initData();
		},
		mounted() {
			pageUtil.checkWechatAll();

			this.initShare();
		},
		methods: {
			handleAdd() {
				if (!pageUtil.applyForPermission('发布新增内容', pageUtil.mapping.mapSystemTip('无权限'))) {
					return;
				}
				pageUtil.gotoPage('publish/add');
			},
			initData() {
				uni.stopPullDownRefresh();

				this.query.page = 1;
				pageUtil.webApi.getPublishList(this.query)
					.then(res => {
						this.data = res.data;
						this.max = res.total;
					})
					.catch(err => {
						pageUtil.toast(err);
						// uni.stopPullDownRefresh();
					});
				this.initCalendar();
			},
			initCalendar() {
				pageUtil.webApi.getPublishNum({
					date: dayjs().format('YYYY-MM')
				}).then((res) => {
					var nowMonth = parseInt(dayjs().format('YYYY-MM').substring(5, 7));
					var nowYear = parseInt(dayjs().format('YYYY-MM').substring(0, 4));
					var days = this.get_month_days(nowMonth, nowYear);
					var list = this.objToArray(res.data);
					if (list && list.length === days) {
						for (var i = 0; i < days; i++) {
							var date = (nowYear + '-' + nowMonth + '-' + (i + 1)).replace(/-(\d)(?!\d)/g, '-0$1');
							if (list[i]) {
								this.dateNum[date] = list[i];
							} else {
								delete this.dateNum[date];
							}
						}
					}
				}).catch((err) => {
					pageUtil.toast(err);
				})
			},
			objToArray(obj) {
				return Object.keys(obj).map(function(key) {
					return obj[key];
				});
			},
			initCalendarByMonth(monthStr) {
				pageUtil.webApi.getNoteCalendar({
						time: monthStr,
						_silent: true
					})
					.then(res => {
						var nowMonth = parseInt(monthStr.substring(5, 7));
						var nowYear = parseInt(monthStr.substring(0, 4));
						var days = this.get_month_days(nowMonth, nowYear);
						var list = res.res;
						if (list && list.length === days) {
							for (var i = 0; i < days; i++) {
								var date = (nowYear + '-' + nowMonth + '-' + (i + 1)).replace(/-(\d)(?!\d)/g, '-0$1');
								if (list[i]) {
									this.dateNum[date] = list[i];
								} else {
									delete this.dateNum[date];
								}
							}
						}
					})
					.catch(err => {
						console.log(err);
					});
			},
			initShare() {
				var that = this;
				if (this.pageDisplayed) {
					pageUtil.prepareForWxShare({
						link: window.location.href,
						description: '事程管理',
						title: '今日'
					});
				} else {
					setTimeout(() => {
						that.initShare();
					}, 100);
				}
			},
			get_month_days(nowMonth, nowYear) {
				let month_arr = [1, 3, 5, 7, 8, 10, 12];
				let days = 0;
				if (nowMonth == 2) {
					if (nowYear % 4 == 0) {
						days = 29;
					} else {
						days = 28;
					}
				} else if (month_arr.indexOf(nowMonth) >= 0) {
					days = 31;
				} else {
					days = 30;
				}
				return days;
			},
			setListData() {
				var param = Object.assign({}, this.query);
				param.page += 1;
				pageUtil.webApi.getPublishList(param)
					.then(res => {
						if (res.data.length > 0) {
							this.query.page += 1;
						}
						this.data = this.data.concat(res.data);
						uni.stopPullDownRefresh();
					})
					.catch(err => {
						pageUtil.toast(err);
					});
			},
			bindDateChange(e) {
				this.date = e.detail.value
			},
			getDate(type) {
				const date = new Date();

				let year = date.getFullYear();
				let month = date.getMonth() + 1;
				let day = date.getDate();

				if (type === 'start') {
					year = year - 10;
				} else if (type === 'end') {
					year = year + 10;
				}
				month = month > 9 ? month : '0' + month;;
				day = day > 9 ? day : '0' + day;

				return `${year}-${month}-${day}`;
			},
			change(e) {
				this.current = e.current
			},

			fabClick() {
				pageUtil.gotoPage('note/add?data=' + JSON.stringify({
					type: "add",
					date: this.query.date
				}));
			},

			changeCalendar(e) {
				this.query.date = e.fulldate;
				this.initData();
			},

		}
	}
</script>

<style lang="scss" scoped>
	.content-inner {
		.text {
			margin: 16rpx 0;
			background-color: #fff;
			text-align: left;
			color: #555;
