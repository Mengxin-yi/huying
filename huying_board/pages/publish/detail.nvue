					.month {
						top: 18rpx;
					}
				}
			}

			.uni-collapse-item__wrap.is--transition {
				// height: auto !important;
				display: none;
			}

			.content {
				padding: 20rpx 40rpx;

				.uni-collapse-item__wrap {
					// height: auto;
				}

				.content {
					border-top: 1rpx solid red !important;
				}

				.row {
					padding: 30rpx 30rpx;
				}

				.text {
					color: var(--info-color);
				}

				.pictures {
					.grid-item-box {
						border: none;
						position: relative;
