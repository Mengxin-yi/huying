<template>
	<view class="content-inner">
		<page-share :show="showShareTip" @close="handleShareTipClose"></page-share>
		<media-item v-if="!loading" ref="mediaItem" :options="entityMessage" @share="handleShare"></media-item>
	</view>
</template>

<script>
	import pageUtil from '../../common/js/utils/page.js';
	import imgStatic from '../../static/image/cat.jpeg';
	import mediaItem from './publish-item.nvue';

	export default {
		components: {
			mediaItem
		},
		data() {
			return {
				data: {},
				listData: [],
				year: '',
				entityMessage: {},
				loading: false,
				entityProfile: {},
				weiguang: false,
				pageDisplayed: false,
				showShareTip: false,
				pageElement: pageUtil.pageElement()
			}
		},
		onLoad(e) {
			this.initData(e);
		},
		onShow() {
			// pageUtil.checkWechatAll();
			// pageUtil.checkAuthOk('publish/detail');

			this.pageDisplayed = true;
		},
		mounted() {
			// pageUtil.checkWechatAll();

			this.year = pageUtil.helper.date.formatDateTime(new Date()).substring(0, 4);
			this.getData();
		},
		methods: {
			getData() {
				this.loading = true;
				pageUtil.webApi.getWeiguangSupplyment(this.data) // getPublishDetail
					.then(res => {
						// this.entityMessage = pageUtil.mapping.mapWeiguangYouquan(res.datas); // res.data
						this.entityMessage = res.datas;
						console.log(res.datas)
						// if (this.entityProfile.avatar_img) {
						// 	this.entityMessage.image_url = this.entityProfile.avatar_img;
						// }
						this.entityMessage.weiguang = this.weiguang;
						this.initShare();
						this.loading = false;
						setTimeout(() => {
							this.$refs.mediaItem.handleCommentList();
						}, 200);
					})
					.catch(err => {
						pageUtil.toast(err);
					});
				// pageUtil.webApi.getProfile({
				// 		_silent: true,
				// 		_no_disturb: true
				// 	})
				// 	.then(res => {
				// 		this.entityProfile = res.item;
				// 		if (this.entityProfile.avatar_img) {
				// 			this.entityMessage.image_url = this.entityProfile.avatar_img;
				// 		}
				// 	})
				// 	.catch(err => {
				// 		pageUtil.toast(err);
				// 	});
			},
			initData(e) {
				pageUtil.webApi.updateWeiguangReadNum({
						data_id: this.$route.query.data_id,
						data_type: this.$route.query.data_type,
						_silent: true
					})
					.then(res => {
				
					})
					.catch(err => {
						console.log(err);
					});
				if (e && e.data) {
					this.data = JSON.parse(e.data);
				} else if (this.$route.query.data_id && this.$route.query.data_type) {
					this.data = {
						data_id: this.$route.query.data_id,
						data_type: this.$route.query.data_type
					};
					if (this.$route.query.type === 'weiguang') {
						pageUtil.setNavBarTitle('微逛');
						this.weiguang = true;
					}
				}
			},
			initShare() {
				if (!this.pageElement.weiguang.share) {
					return;
				}
				var that = this;
				if (this.pageDisplayed) {
					pageUtil.prepareForWxShare({
						link: window.location.href,
						description: this.entityMessage.content ? this.entityMessage.content.substring(0, 30) : '',
						title: this.entityMessage.title
					});
				} else {
					setTimeout(() => {
						that.initShare();
					}, 100);
				}
			},
			handleImage(index, obj, message) {
				uni.previewImage({
					urls: message.img_list,
					current: obj,
					success: function(res) {
						console.log(res);
					},
					fail: function(res) {
						console.log(res);
					},
					complete: function(res) {
						console.log(res);
					},
				});
			},
			handleShare() {
				this.showShareTip = !this.showShareTip;
			},
			handleShareTipClose() {
				this.showShareTip = false;
			}
		}
	}
</script>

