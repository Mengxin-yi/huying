			border-radius: 20rpx;

			.subtitle {
				font-size: 28rpx;
				padding-bottom: 10rpx;
				flex-direction: row;

				.line {
					padding: 0rpx 10rpx;
				}

				.tag {
					color: var(--primary-color);
					border: 1rpx solid var(--primary-color);
					border-radius: 8rpx;
					padding: 0rpx 5rpx;
				}
			}

			.uni-list .keywords {
				padding: 20rpx 0rpx;
			}

			.uni-list .uni-list-item:last-child {
				min-height: 20rpx;
			}

			.uni-grid-wrap {
				// border-top: 1rpx solid var(--inner-line-color);
				height: 80rpx !important;

				.uni-grid-item {
					height: 80rpx !important;
				}
			}

			:deep(.uni-grid-item__box) {
				align-items: center;
				justify-content: center;
				// border-top-width: 0rpx;
				// border-bottom-width: 0rpx;
				// border-right-width: 1rpx;
				// border-color: var(--inner-line-color) !important;
			}

			:deep(.uni-grid--border) {
				// border-left-width: 0rpx;
			}

			&.publish {
				.logo {
					border-top: 1rpx solid var(--inner-line-color);
					padding: 20rpx 200rpx;
				}
			}

			&.banner {
				padding: 0rpx 0rpx;
			}
		}

		:deep(._media) {
			border-radius: 20rpx;
			// height: 180rpx !important;
			// box-sizing: border-box;
			// margin: 20rpx 30rpx;
			// width: calc(100vw - 60rpx) !important;
		}
	}

	.text {
		font-size: 12px;
		color: #666;
		margin-top: 5px;
	}

	.uni-px-5 {
		padding-left: 10px;
		padding-right: 10px;
	}

	.uni-pb-5 {
