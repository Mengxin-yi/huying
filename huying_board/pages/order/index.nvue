<template>
	<view style="width: 100%;height: 100vh;" :class="{'content-inner': true, 'tabs': true, 'weixin': isWeixin}">
		<uni-card :border="false" :isFull="true" padding="0" spacing="10" :is-shadow="false">
			<uni-notice-bar v-if="perfectVisible" class="auth" clickable show-icon scrollable
				text="不错失任何一个机会，立刻建立第一项订阅吧" @click="handlePerfect" />
			<uni-list-item title="" style="padding: 10px;" class="tab-date">
				<template v-slot:body>
					<lxCalendar v-model:value="selectedDate" :date_tip="dateNum" @change="changeCalendarTab" brief>
					</lxCalendar>
				</template>
			</uni-list-item>
		</uni-card>

		<scroll-view v-if="tabBars.length>0" id="tab-bar" class="scroll-h" :scroll-x="true" :show-scrollbar="false"
			:scroll-into-view="scrollInto">
			<view v-for="(tab,index) in tabBars" :key="tab.id" class="uni-tab-item" :id="tab.id" :data-current="index"
				@click="ontabtap">
				<text class="uni-tab-item-title"
					:class="tabIndex==index ? 'uni-tab-item-title-active' : ''">{{tab.name}}</text>
			</view>
		</scroll-view>
		<view class="line-h" v-if="tabBars.length>0"></view>
		<swiper v-if="tabBars.length>0" :current="tabIndex" class="swiper-box" style="flex: 1;" :duration="300"
			@change="ontabchange">
			<swiper-item class="swiper-item" v-for="(tab,index1) in newsList" :key="index1">
				<!-- #ifdef APP-NVUE -->
				<list class="scroll-v list" enableBackToTop="true" scroll-y loadmoreoffset="15"
					@loadmore="loadMore(index1)">
					<refresh class="refresh" @refresh="onrefresh(index1)" @pullingdown="onpullingdown"
						:display="tab.refreshing ? 'show' : 'hide'">
						<div class="refresh-view">
							<image class="refresh-icon" :src="refreshIcon"
								:style="{width: (tab.refreshing || pulling) ? 0: '30px'}"
								:class="{'refresh-icon-active': tab.refreshFlag}"></image>
							<loading-indicator class="loading-icon" animating="true"
								v-if="tab.refreshing"></loading-indicator>
							<text class="loading-text">{{tab.refreshText}}</text>
						</div>
					</refresh>
					<cell class="small-time" v-if="tab.time_list">
						<view v-for="(itemSmallTime, indexSmallTime) in tab.time_list"
							:class="{'button': true, 'active': itemSmallTime.value === tab.time}"
							@click="handleSmallTime(itemSmallTime, indexSmallTime)">{{ itemSmallTime.label }}</view>
					</cell>
					<cell v-for="(newsitem,index2) in tab.data" :key="newsitem.id">
						<media-item style="width: 98%;margin: 3px auto;background: #fff;border-radius: 3px;"
							:options="newsitem" @close="close(index1,index2)" @click="goDetail(newsitem)"
							@longpressTrigger="handleLongPress(newsitem)"></media-item>
					</cell>
					<cell class="loading-more" v-if="tab.isLoading || tab.data.length > 4">
						<text class="loading-more-text">{{tab.loadingText}}</text>
					</cell>
				</list>
				<!-- #endif -->
				<!-- #ifndef APP-NVUE -->
				<scroll-view class="scroll-v list" enableBackToTop="true" scroll-y @scrolltolower="loadMore(index1)">
					<view class="small-time" v-if="tab.time_list">
						<view v-for="(itemSmallTime, indexSmallTime) in tab.time_list"
							:class="{'button': true, 'active': itemSmallTime.value === tab.time}"
							@click="handleSmallTime(itemSmallTime, indexSmallTime)">{{ itemSmallTime.label }}</view>
					</view>
					<view v-for="(newsitem,index2) in tab.data" :key="newsitem.id">
						<media-item style="width: 98%;margin: 3px auto;background: #fff;border-radius: 3px;"
							:options="newsitem" @close="close(index1,index2)" @click="goDetail(newsitem)"
							@longpressTrigger="handleLongPress(newsitem)"></media-item>
					</view>
					<page-empty v-if="!tab.data || Object.keys(tab.data).length === 0"></page-empty>
					<view class="loading-more" v-if="tab.isLoading || tab.data.length > 4">
						<text class="loading-more-text">{{tab.loadingText}}</text>
					</view>
				</scroll-view>
				<!-- #endif -->
			</swiper-item>
		</swiper>
		<page-empty v-else></page-empty>
		<!-- <uni-fab ref="fab" :pattern="pattern" :content="content" horizontal="right" vertical="bottom" direction="horizontal" @trigger="handleSmart" /> -->
		<!-- 		<uni-fab ref="fab" :pattern="pattern" horizontal="right" vertical="bottom" direction="horizontal"
			@fabClick="fabClick" /> -->

		<uni-fab ref="fab" style="width:33px;height:33px;" :pattern="pattern"
			:content="pageElement.weiguang.multiColumn ? content : content.filter(e => e.text !== '栏目')"
			horizontal="right" vertical="bottom" direction="horizontal" @trigger="handleSmart" />

		<novice-guidance v-if="perfectVisible" :step="step"></novice-guidance>
		<cc-rightPopup :pop-show="popShowFilter" :colors="colors" :classList="classListFilter"
			@sureClick="sureClickFilter" @hideClick="hideright" :price-show="false"></cc-rightPopup>
		<cc-rightPopup :pop-show="popShowSort" :colors="colors" :classList="classListSort" @sureClick="sureClickSort"
			@hideClick="hideright" :price-show="false"></cc-rightPopup>
		<uni-popup ref="popup" background-color="#fff" @change="changeNote" :isMaskClick="false">
			<view class="popup-content">
				<view class="district">
					<view class="row title">添加到事程</view>
					<view class="row">
						<lxCalendar @change="changeCalendar"></lxCalendar>
					</view>
					<view class="row">
						<picker mode="time" :value="remindOption.time" @change="bindTimeChange">
							<view class="uni-input">
								{{remindOption.time && remindOption.time.length ? remindOption.time : '自定义时间'}}
							</view>
						</picker>
					</view>
					<view class="row">
						<button type="default" @click="handleDismissNote">取消</button>
						<button type="primary" @click="handleSubmitNote">添加</button>
					</view>
				</view>
			</view>
		</uni-popup>
		<!-- 提示窗示例 -->
		<uni-popup ref="alertDialog" type="dialog">
			<uni-popup-dialog type="info" cancelText="关闭" confirmText="同意" title="" content="用户未权限请购买会员!"
				@confirm="dialogConfirm"></uni-popup-dialog>
		</uni-popup>
	</view>
</template>

<script>
	import dayjs from 'dayjs'
	import pageUtil from '../../common/js/utils/page.js';
	import mediaItem from '../weiguang/news-item.nvue';
	import lxCalendar from '../../components/lx-calendar/lx-calendar.vue';
	import imgClock from '../../static/icon/misc/clock.png'

	// 缓存每页最多
	const MAX_CACHE_DATA = 100;
	// 缓存页签数量
	const MAX_CACHE_PAGE = 3;

	export default {
		components: {
			mediaItem,
			lxCalendar
		},
		data() {
			return {
				pageElement: pageUtil.pageElement(),
				query: {
					remind_time: '',
					search_text: '',
					id: 0,
					order: 'default',
					time_type: 0,
					date: '',
					page: 1,
					page_size: 10
				},
				form: {
					openPush: false
				},
				dateNum: {},
				newsList: [],
				cacheTab: [],
				tabIndex: 0,
				tabBars: [],
				scrollInto: "",
				showTips: false,
				navigateFlag: false,
				pulling: false,
				refreshIcon: "",
				pattern: {
					color: '#7A7E83',
					backgroundColor: '#fff',
					selectedColor: '#007AFF',
					buttonColor: '#007AFF',
					iconColor: '#fff',
					icon: 'list'
				},
				content: [{
					iconPath: '/static/icon/smart/reserve.png',
					selectedIconPath: '/static/icon/smart/reserveHL.png',
					text: '全部订阅',
					active: false
				}, {
					iconPath: '/static/icon/publish.png',
					selectedIconPath: '/static/icon/publishHL.png',
					text: '添加订阅',
					active: false
				}],
				colors: '#557ff7',
				popShowSort: false,
				classListSort: [{
					name: '排序内容',
					id: 1,
					child: []
				}],
				popShowFilter: false,
				classListFilter: [{
					name: '发布时间',
					id: 1,
					child: []
				}],
				isWeixin: false,
				remindOption: {
					date: '',
					time: ''
				},
				selectedDate: '',
				step: {
					name: 'order/index',
					vueFixes: false,
					guideList: [{
						el: '.auth',
						tips: '点击完善个人信息，获得更准确的内容推荐',
						next: '下一步',
						part: 'left',
						weixin: {
							grid: {
								top: 'navBarHeight'
							}
						}
					}]
				},
				perfectVisible: false,
				firstInited: false,
				urlInited: false
			}
		},
		onLoad() {
			// this.initTab();
		},
		onShow() {
			this.initTab();
			pageUtil.webApi.getpublishcommentlikenum().then((res) => {
				if (res.status_code == 200) {
					if (res.num > 0) {
						uni.setTabBarBadge({
							index: 3,
							text: res.num + ''
						})
					}
				} else {
					uni.removeTabBarBadge({
						index: 3,
					})
				}
			})
			pageUtil.checkAuthOk('order/index');
			if (this.tabBars.length > 0) {
				var obj = uni.getStorageSync('order/tab');
				if (obj) {
					var entity = JSON.parse(obj);
					var index = this.tabBars.findIndex(e => 'tab' + entity.id === e.id);
					if (index > -1) {
						this.switchTab(index);
					}
				}

				if (this.firstInited) {
					this.initTab(true);
				}
				this.firstInited = true;
			}
			uni.removeStorageSync('order/tab');
		},
		onPullDownRefresh() {
			// console.log('onPullDownRefresh');
			uni.stopPullDownRefresh();
			this.initTab();
			// this.initData();
		},
		mounted() {
			pageUtil.checkWechatAll();
			this.isWeixin = pageUtil.isWeixin();
			this.refreshIcon = pageUtil.sysdict.icon.refresh;
			this.classListSort[0].child = pageUtil.sysdict.sortOrderType;
			this.classListFilter[0].child = pageUtil.sysdict.filterTimeType;
		},
		methods: {
			//购买会员跳转
			dialogConfirm() {
				uni.navigateTo({
					url: '/pages/prefer/vip/index'
				});
			},
			initTab(silent) {
				pageUtil.webApi.getPushNum({
					date: dayjs().format('YYYY-MM')
				}).then((res) => {
					var nowMonth = parseInt(dayjs().format('YYYY-MM').substring(5, 7));
					var nowYear = parseInt(dayjs().format('YYYY-MM').substring(0, 4));
					var days = this.get_month_days(nowMonth, nowYear);
					var list = this.objToArray(res.data);
					if (list && list.length === days) {
						for (var i = 0; i < days; i++) {
							var date = (nowYear + '-' + nowMonth + '-' + (i + 1)).replace(/-(\d)(?!\d)/g, '-0$1');
							if (list[i]) {
								this.dateNum[date] = list[i];
							} else {
								delete this.dateNum[date];
							}
						}
					}
				}).catch((err) => {
					// pageUtil.toast(err);
				})
				pageUtil.webApi.getOrderList({
						_silent: silent
					})
					.then(res => {
						this.perfectVisible = res.data.length === 0;
						var arr = res.data.map(m => {
							var n = Object.assign({}, m);
							var arr = pageUtil.sysdict.weiguangType.filter(e => e.id === m.data_type);
							n.type = arr.length > 0 ? arr[0].name : '';
							return n;
						});
						if (arr.length === 0) {
							return;
						}
						var date = pageUtil.helper.date.formatDateTime(new Date()).substring(0, 10);
						var typeid = '';
						var toindex = '';
						if (!this.urlInited && this.$route.query.id && this.$route.query.date && this.$route.query.date
							.length === 10) {
							date = this.$route.query.date;
							typeid = this.$route.query.id;
							this.selectedDate = date;
						}
						this.tabBars = arr.map(m => {
							var n = Object.assign({}, m);
							n.id = 'tab' + n.id;
							n.name = m.title;
							return n;
						});
						this.tabBars.forEach((tabBar, index) => {
							var param = Object.assign({}, this.query);
							param.date = date;
							param.id = tabBar.id.replace('tab', '');
							this.newsList.push({
								data: [],
								isLoading: false,
								refreshText: "",
								loadingText: '加载更多...',
								query: param,
								max: 0
							});
							// console.log('index',tabBar.id,index)
							//判断是否调tab
							if (tabBar.id == 'tab' + typeid) {
								toindex = index
							}
						});
						// console.log('??',toindex)
						this.getList(0, false, silent);
						this.switchTab(toindex);
					})
					.catch(err => {
						pageUtil.toast(err);
					});
			},
			objToArray(obj) {
				return Object.keys(obj).map(function(key) {
					return obj[key];
				});
			},
			get_month_days(nowMonth, nowYear) {
				let month_arr = [1, 3, 5, 7, 8, 10, 12];
				let days = 0;
				if (nowMonth == 2) {
					if (nowYear % 4 == 0) {
						days = 29;
					} else {
						days = 28;
					}
				} else if (month_arr.indexOf(nowMonth) >= 0) {
					days = 31;
				} else {
					days = 30;
				}
				return days;
			},
			initData() {
				this.newsList[this.tabIndex].query.page = 1;
				this.getList(this.tabIndex);
				// setTimeout(() => {

				// 	uni.stopPullDownRefresh();
				// }, 300);

			},
			getList(index, loadMore, silent) {
				let activeTab = this.newsList[index];
				var param = Object.assign({}, activeTab.query);
				param._silent = silent;
				if (loadMore) {
					if (activeTab.max <= activeTab.data.length) {
						this.newsList[index].loadingText = '没有更多数据了!';
						return;
					}
					param.page += 1;
				}
				// if(param.time){
				// 	delete param.time
				// }

				pageUtil.webApi.getOrderIndex(param)
					.then(res => {
						var list = res.data.map(m => {
							var n = activeTab.query.data_type === 'publish' ? pageUtil.mapping
								.mapWeiguangYouquan(m) : pageUtil.mapping.mapWeiguangDetail(m);
							return n;
						});
						activeTab.max = res.total;
						if (loadMore && list.length > 0) {
							activeTab.query.page += 1;
							activeTab.data = activeTab.data.concat(list);
							activeTab.time = res.time;
							activeTab.time_list = res.time_list;
						} else if (!loadMore) {
							activeTab.data = list;
							activeTab.time = res.time;
							activeTab.time_list = res.time_list;
						}
						uni.stopPullDownRefresh();
					})
					.catch(err => {
						pageUtil.toast(err);
						uni.stopPullDownRefresh();
					});
			},
			goDetail(e) {
				var activeTab = this.newsList[this.tabIndex];
				console.log(activeTab)
				if (activeTab.query.data_type === 'publish') {
					return;
				}
				if (this.navigateFlag) {
					return;
				}
				this.navigateFlag = true;
				console.log(e)
				var param = Object.assign({}, e);
				delete param['content'];
				delete param['content_str'];
				delete param['contentHtml'];
				pageUtil.gotoPage('weiguang/detail?data_id=' + param.data_id + '&data_type=' + param.data_type +
					'&type=order');
				// pageUtil.gotoPage('weiguang/detail?data=' + JSON.stringify(param));
				setTimeout(() => {
					this.navigateFlag = false;
				}, 200);

				e.read_status = 1;
				e.read_num += 1;
			},
			close(index1, index2) {
				uni.showModal({
					content: '是否删除本条信息？',
					success: (res) => {
						if (res.confirm) {
							this.newsList[index1].data.splice(index2, 1);
						}
					}
				})
			},
			loadMore(e) {
				setTimeout(() => {
					this.getList(this.tabIndex, true);
				}, 500)
			},
			ontabtap(e) {
				let index = e.target.dataset.current || e.currentTarget.dataset.current;
				this.switchTab(index);
			},
			ontabchange(e) {
				let index = e.target.current || e.detail.current;
				this.switchTab(index);
			},
			switchTab(index) {
				if (this.tabIndex === index) {
					return;
				} {
					this.getList(index);
					// if (this.newsList[index].data.length === 0) {
					// 	this.getList(index);
					// }
					// 缓存 tabId
					// if (this.newsList[this.tabIndex].data.length > MAX_CACHE_DATA) {
					// 	let isExist = this.cacheTab.indexOf(this.tabIndex);
					// 	if (isExist < 0) {
					// 		this.cacheTab.push(this.tabIndex);
					// 	}
					// }
					// this.scrollInto = this.tabBars[index].id;

					// 释放 tabId
					// if (this.cacheTab.length > MAX_CACHE_PAGE) {
					// 	let cacheIndex = this.cacheTab[0];
					// 	this.clearTabData(cacheIndex);
					// 	this.cacheTab.splice(0, 1);
					// }
				}
				this.tabIndex = index
				this.selectedDate = this.newsList[index].query.date;
				///旧逻辑
				// if (this.newsList[index].data.length === 0) {
				// 	this.getList(index);
				// }

				// if (this.tabIndex === index) {
				// 	return;
				// }

				// // 缓存 tabId
				// if (this.newsList[this.tabIndex].data.length > MAX_CACHE_DATA) {
				// 	let isExist = this.cacheTab.indexOf(this.tabIndex);
				// 	if (isExist < 0) {
				// 		this.cacheTab.push(this.tabIndex);
				// 		//console.log("cache index:: " + this.tabIndex);
				// 	}
				// }

				// this.tabIndex = index;
				// this.scrollInto = this.tabBars[index].id;
				// this.selectedDate = this.newsList[index].query.date;

				// // 释放 tabId
				// if (this.cacheTab.length > MAX_CACHE_PAGE) {
				// 	let cacheIndex = this.cacheTab[0];
				// 	this.clearTabData(cacheIndex);
				// 	this.cacheTab.splice(0, 1);
				// 	//console.log("remove cache index:: " + cacheIndex);
				// }
			},
			clearTabData(e) {
				this.newsList[e].data.length = 0;
				this.newsList[e].loadingText = "加载更多...";
			},
			refreshData() {},
			onrefresh(e) {
				var tab = this.newsList[this.tabIndex];
				if (!tab.refreshFlag) {
					return;
				}
				tab.refreshing = true;
				tab.refreshText = "正在刷新...";

				setTimeout(() => {
					this.refreshData();
					this.pulling = true;
					tab.refreshing = false;
					tab.refreshFlag = false;
					tab.refreshText = "已刷新";
					setTimeout(() => { // TODO fix ios和Android 动画时间相反问题
						this.pulling = false;
					}, 500);
				}, 2000);
			},
			onpullingdown(e) {
				var tab = this.newsList[this.tabIndex];
				if (tab.refreshing || this.pulling) {
					return;
				}
				if (Math.abs(e.pullingDistance) > Math.abs(e.viewHeight)) {
					tab.refreshFlag = true;
					tab.refreshText = "释放立即刷新";
				} else {
					tab.refreshFlag = false;
					tab.refreshText = "下拉可以刷新";
				}
			},
			handleSearch(e) {
				let activeTab = this.newsList[this.tabIndex];
				activeTab.query.search_text = e.value;
				activeTab.query.page = 1;
				this.getList(this.tabIndex);
			},
			handleSmart(e) {
				// this.content[e.index].active = !e.item.active;
				if (e.index === 0) {
					pageUtil.gotoPage('order/list');
				} else if (e.index === 1) {
					if (!this.pageElement.noteAdd.clickMe) {
						this.form.openPush = false;
						this.$refs.alertDialog.open()
					} else {
						pageUtil.webApi.getUserVip({
							_silent: true
						}).then(res => {
							console.log(res)
							if (res.item && res.item.current_vip_label != '普通用户') {
								pageUtil.gotoPage('order/add');
							} else {
								pageUtil.toast('暂未开通会员服务或会员已过期！');
							}

						})
					}
				}
				// uni.showModal({
				// 	title: '提示',
				// 	content: `您${this.content[e.index].active ? '选中了' : '取消了'}${e.item.text}`,
				// 	success: function(res) {
				// 		if (res.confirm) {
				// 			console.log('用户点击确定')
				// 		} else if (res.cancel) {
				// 			console.log('用户点击取消')
				// 		}
				// 	}
				// })
			},
			changeClick(arr) {
				// 适配小程序 样式需要在父级改变
				this.classList = arr;
			},
			hideright() {
				this.popShowSort = false;
				this.popShowFilter = false;
			},
			sureClickSort(paramDict, selArr) {
				this.popShowSort = false;
				let activeTab = this.newsList[this.tabIndex];
				var arr = selArr.filter(e => e.current);
				activeTab.query.order = arr.length > 0 ? arr[0].id : 'default';
				this.initData();
			},
			sureClickFilter(paramDict, selArr) {
				this.popShowFilter = false;
				let activeTab = this.newsList[this.tabIndex];
				var arr = selArr.filter(e => e.current);
				activeTab.query.time_type = arr.length > 0 ? arr[0].id : 0;
				this.initData();
			},
			handleLongPress(e) {
				// console.log(JSON.stringify(e));
				var date = pageUtil.helper.date.formatDateTime(new Date()).substring(0, 10);
				this.remindOption = {
					date: date,
					time: '',
					data: e
				};
				this.$refs.popup.open('center');
			},
			changeNote(e) {
				// console.log('当前模式：' + e.type + ',状态：' + e.show);
			},
			changeCalendar(e) {
				// console.log(e);
				this.remindOption.date = e.fulldate;
			},
			handleDismissNote() {
				this.$refs.popup.close();
			},
			handleSubmitNote() {
				if (pageUtil.isFirstUse()) {
					return;
				}
				var title = this.remindOption.data.data_type === 'publish' ? this.remindOption.data.company : this
					.remindOption.data.title;
				var content = this.remindOption.data.abstract ? this.remindOption.data.abstract : this.remindOption.data
					.content.substring(0, 140);
				var param = Object.assign({}, {
					data_id: this.remindOption.data.data_id,
					data_type: this.remindOption.data.data_type
				}, {
					title: title,
					content: content,
					remind_time: this.remindOption.date + ' ' + this.remindOption.time,
					weight: 0,
					news_set: 0
				});
				if (pageUtil.helper.other.isEmpty(this.remindOption.time)) {
					var nowadays = new Date();
					var nowadaysStr = pageUtil.helper.date.formatDateTime(nowadays).substring(0, 10);
					if (param.remind_time.trim() === nowadaysStr) {
						var timeNew = pageUtil.helper.date.addHours(nowadays, 1);
						var time = pageUtil.helper.date.formatDateTime(timeNew).substring(11, 19);
						param.remind_time = param.remind_time + time;
					} else {
						param.remind_time = param.remind_time + "08:00:00";
					}
				}

				pageUtil.webApi.addNote(param)
					.then(res => {
						pageUtil.toast('添加事程成功');
						pageUtil.markState('note/add');
						this.$refs.popup.close();
					})
					.catch(err => {
						pageUtil.toast(err);
					});
			},
			bindTimeChange(e) {
				this.remindOption.time = e.detail.value;
			},
			handlePerfect() {
				if (!this.pageElement.noteAdd.clickMe) {
					this.form.openPush = false;
					this.$refs.alertDialog.open()
				} else {
					pageUtil.gotoPage('order/add');
				}
			},
			changeCalendarTab(e) {
				var activeTab = this.newsList[this.tabIndex];
				this.newsList.map((res) => {
					res.query.date = e.fulldate
					res.query.time = ''
				})
				pageUtil.webApi.getPushNum({
					date: dayjs(e.fulldate).format('YYYY-MM')
				}).then((res) => {
					var nowMonth = parseInt(dayjs(e.fulldate).format('YYYY-MM').substring(5, 7));
					var nowYear = parseInt(dayjs(e.fulldate).format('YYYY-MM').substring(0, 4));
					var days = this.get_month_days(nowMonth, nowYear);
					var list = this.objToArray(res.data);
					if (list && list.length === days) {
						for (var i = 0; i < days; i++) {
							var date = (nowYear + '-' + nowMonth + '-' + (i + 1)).replace(/-(\d)(?!\d)/g, '-0$1');
							if (list[i]) {
								this.dateNum[date] = list[i];
							} else {
								delete this.dateNum[date];
							}
						}
					}
					// console.log(')))',this.dateNum)
				}).catch((err) => {
					// pageUtil.toast(err);
				})

				this.initData();
			},
			fabClick() {
				pageUtil.gotoPage('order/list');
			},
			handleSmallTime(itemSmallTime, indexSmallTime) {
				var activeTab = this.newsList[this.tabIndex];
				activeTab.query.time = itemSmallTime.value;
				activeTab.time = activeTab.query.time;
				this.initData();
			}
		}
	}
</script>

