<template>
	<uni-popup ref="message" type="message">
		<uni-popup-message :type="msgType" :message="messageText" :duration="2000"></uni-popup-message>
	</uni-popup>
	<view class="" style="width: 100%;padding: 10px;background: #fff;">
		<hya-form ref="hyaForm" :infoList="infoList" />
		<view class="" style="width: 100%;display: flex;flex-direction: row;margin-top: 10px;">

			<div style="width: 48%;height: 100px;padding: 10px;position: relative;" @click="sddowunone">
				<img :src="fileListsa" alt="" style="width: 100%;height: 100%;" />
			</div>
			<span style="position: absolute;bottom:-10px;left:10px;font-size: 10px;color:red;">证书照片(png、jpg、jpeg)</span>
		</view>
		<button style="width: 90%;margin: 40px auto;" type="primary" @click="submit">提交</button>
	</view>
</template>

<script>
	import fileListsa from './ima/errimg.png';
	import pageUtil from '../../common/js/utils/page.js';
	import hyaForm from '@/uni_modules/hya-form/components/hya-form/hya-form.uvue';
	export default {
		components: {
			hyaForm,
		},
		onShow() {},
		data() {
			return {
				check_stat: '',
				fileListsa,
				isupimaga:false,
				// isrz:true,
				infoList: [{
					type: 'input',
					title: '发证机构',
					placeholder: '请输入发证机构',
					key: 'issuing_authority',
					value: '',
					titleType: 3,
					required: true,
					disabled: false,
				}, {
					type: 'input',
					title: '技能等级',
					placeholder: '请输入技能等级',
					key: 'level',
					value: '',
					titleType: 3,
					required: true,
					disabled: false,
				}, {
					type: 'input',
					title: '技能名称',
					placeholder: '请输入技能名称',
					key: 'name',
					value: '',
					titleType: 3,
					required: true,
					disabled: false,
				}, {
					titleIcon: '',
					type: 'date',
					title: '授予时间',
					placeholder: '请选择授予时间',
					key: 'award_time',
					value: '',
					titleType: 3,
					required: true,
					disabled: false,
				}]
			}
		},
		methods: {
			messageToggle(type, info) {
				this.msgType = type
				this.messageText = info
				this.$refs.message.open()
			},
			submit() {
				let that = this
				if (this.$refs['hyaForm'].getFormValue()) {
					if (!that.isupimaga) {
						that.messageToggle('error', '请上传证书照片')
						return
					}
					let filearr = []
					if (that.fileListsa.indexOf('blob:') > -1) {
						filearr.push({
							name: 'file',
							uri: that.fileListsa
						})
					}
					uni.uploadFile({
						url: '/bpi/skill_add',
						files: filearr,
						formData: {
							'token': uni.getStorageSync('token'),
							'issuing_authority': that.$refs['hyaForm'].getFormValue()['issuing_authority'],
							'level': that.$refs['hyaForm'].getFormValue()['level'],
							'name': that.$refs['hyaForm'].getFormValue()['name'],
							'award_time': that.$refs['hyaForm'].getFormValue()['award_time'],
						},
						header: {
							'app-name': 'huying'
						},
						success: (res) => {
							uni.hideLoading();
							that.messageToggle('success', JSON.parse(res.data).msg)
						},
						fail(err) {
							uni.hideLoading();
							that.messageToggle('error', err)
						},
						complete() {
							setTimeout(function() {
								uni.navigateBack({
									delta: 1
								})
							}, 1000)
						}
					});
				}
			},
			async sddowunone() {
				const that = this;
				uni.chooseImage({
					sourceType: ['camera', 'album'],
					sizeType: ['compressed'],
					count: 1,
					success: (res) => {
						for (var key in res.tempFiles) {
							var e = res.tempFiles[key];
							if (e.size > pageUtil.constant.imageFileMaxSize) {
								pageUtil.toast('单张图片大小不能超过' + pageUtil.constant.imageFileMaxSizeString);
								return;
							}
						}
						that.fileListsa = res.tempFilePaths[0];
						that.isupimaga = true;
					},
					fail: (err) => {
						console.log("err: ", err);

					}
				})
			}
		}
	}
</script>

<style lang="scss" scoped>
	.example-body {
		padding: 10px;
		padding-top: 0;
	}

	.custom-image-box {
		/* #ifndef APP-NVUE */
		display: flex;
		/* #endif */
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
	}

	.text {
		font-size: 14px;
		color: #333;
	}

	.hya-form {
		width: 100%;

		.hya-form-item {
			width: 100%;
		}

		.hya-form-bottom {
			margin-bottom: 12px;
		}
	}
</style>