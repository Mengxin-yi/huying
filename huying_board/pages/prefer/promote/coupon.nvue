<template>
	<view class="content-inner">
		<view class="coupon-type">
			<uni-segmented-control :current="couponTypeIndex" :values="listCouponType" @clickItem="handleCouponType" />
		</view>
		<page-empty v-if="!listData || Object.keys(listData).length === 0"></page-empty>
		<view class="district">
			<view class="row" v-for="(item, index) in listData" @click="handleDetail(item, index)">
				<view class="l-tickets">
					<view class="name">{{item.card_type}}</view>
					<view class="due">{{item.start_time}} 至 {{item.end_time}}</view>
					<view class="count-down" v-if="!item.overdue && !item.has_used">
						<view class="pre">剩余</view>
						<uni-countdown :day="item.day" :hour="item.hour" :minute="item.minute" :second="item.second" />
					</view>
					<view class="count-down expired" v-if="item.overdue && !item.has_used">
						<view class="pre">已过期</view>
					</view>
					<view class="count-down used" v-if="item.has_used">
						<view class="pre">已使用</view>
					</view>
				</view>
				<view class="r-tickets">
					<view class="price">{{item.price}}<span>元</span></view>
				</view>
			</view>
		</view>
	</view>
</template>

<script>
	import pageUtil from '../../../common/js/utils/page.js';
	
	export default {
		data() {
			return {
				listData: [],
				entityPay: {},
				couponTypeIndex: 0,
				listCouponType: ['全部', '已使用', '已过期'],
				
			}
		},
		mounted() {
			pageUtil.checkWechatAll();
			
			this.getData(-1, -1);
		},
		methods: {
			getData(has_used, overdue) {
				var param = Object.assign({}, {has_used: -1, overdue: -1}, {has_used, overdue});
				pageUtil.webApi.getMyCouponList(param)
				.then(res => {
					this.listData = res.items.map(m => {
						var n = Object.assign({}, m, {day: 0, hour: 0, minute: 0, second: 0});
						var nowadays = new Date();
						var endTime = pageUtil.helper.date.parse(m.end_time);
						var diff = endTime.getTime() - nowadays.getTime();
						if (diff > 0) {
							var str = pageUtil.helper.date.convertSecondsToTime(diff / 1000);
							var arr = str.split('天 ');
							n.day = parseInt(arr[0]);
							var arrTime = arr[1].split(':');
							n.hour = parseInt(arrTime[0]);
							n.minute = parseInt(arrTime[1]);
							n.second = parseInt(arrTime[2]);
						}
						
						return n;
					});
				})
				.catch(err => {
					pageUtil.toast(err);
				});
			},
			handleDetail(obj, index) {
				if (obj.overdue || obj.has_used) {
					return;
				}
				//obj.is_immediate
				pageUtil.webApi.getPayConfig(Object.assign({}, {pk: obj.id, name: obj.card_type, vip_type: obj.card_type, price: obj.price, method: obj.method, num: obj.num, is_immediate: 1, vip_level: obj.vip_level}))
				.then(res => {
					this.entityPay = res.item;
					// pageUtil.toast(this.entityPay.timeStamp + '');
					// return;
					if (window.hasOwnProperty('WeixinJSBridge')) {
						WeixinJSBridge.invoke(
							'getBrandWCPayRequest', {
								"appId": this.entityPay.appid,     //公众号ID，由商户传入     
								"timeStamp": this.entityPay.timeStamp + '',         //时间戳，自1970年以来的秒数     
								"nonceStr": this.entityPay.nonceStr, //随机串     
								"package": "prepay_id=" + this.entityPay.prepay_id,     
								"signType": "MD5",         //微信签名方式：     
								"paySign": this.entityPay.sign //微信签名 
							},
							function(resWx){
								pageUtil.toast(JSON.stringify(resWx));
								if(resWx.err_msg == "get_brand_wcpay_request:ok" || resWx.err_msg.indexOf(':ok') > -1){
									uni.showModal({ content: '支付成功', showCancel:false, success: (res) => { } });
									this.getData({_silent: true});
									// 使用以上方式判断前端返回,微信团队郑重提示：
									//resWx.err_msg将在用户支付成功后返回ok，但并不保证它绝对可靠。
								}
								else {
									
								}
							}
						); 
					}
					else {
						pageUtil.toast('请使用微信打开本应用');
					}
				})
				.catch(err => {
					pageUtil.toast(err);
				});
			},
			handleCouponType(e) {
				if (e.currentIndex === 0) {
					this.getData(-1, -1);
				}
				else if (e.currentIndex === 1) {
					this.getData(1, -1);
				}
				else {
					this.getData(-1, 1);
				}
			}
		}
	}
</script>

<style lang="scss" scoped>
	
	.content-inner {
		padding: 40rpx 30rpx;
		
		// &:root {	// Yellow
		// 	--l1-color: #ffc854;
		// 	--l2-color: #FFB300;
		// 	--r1-color: #ffc854;
		// 	--r2-color: #ffcc61;
		// }
		// &:root {	// Yellow
		// 	--l1-color: #ffc854;
		// 	--l2-color: #FFB300;
		// 	--r1-color: #ffc854;
		// 	--r2-color: #ffcc61;
		// }
		.district {
			color: #f5f5f5;
			
			.row {
				flex-direction: row;
				height: 180rpx;
				margin-bottom: 20rpx;
				
				.l-tickets {
					padding: 20rpx 20rpx;
					
					.name {
						font-weight: bold;
					}
					.due {
						font-size: 22rpx;
					}
					.count-down {
						margin-top: 20rpx;
						font-size: 80rpx;
						flex-direction: row;
						
						:deep(.uni-countdown__number) {
							color: #4A148C !important;
							font-size: 40rpx !important;
							font-weight: bold;
						}
						:deep(.uni-countdown__splitor) {
							color: #f5f5f5 !important;
							font-size: 20rpx !important;
							padding: 0rpx 10rpx;
						}
						.pre {
							font-size: 20rpx;
							line-height: 36rpx;
							padding-right: 20rpx;
						}
					}
				}
				.r-tickets {
					align-items: center;
					justify-content: center;
					
					.price {						
						flex-direction: row;
						font-size: 46rpx;
						font-weight: bold;
						align-items: center;
						justify-content: center;
						
						span {
							position: relative;
							font-size: 22rpx;
							font-weight: normal;
							top: 8rpx;
						}
					}
				}
			}
		}
		.coupon-type {
			margin-bottom: 20rpx;
			padding: 0rpx 10rpx;
		}
		
		.l-tickets {
			display: inline-block;
		  width: 75%;
		  position: relative;
		  background: radial-gradient(circle at right top, transparent 16rpx,#CE93D8 0, #BA68C8 100%) right top / 100% 50% no-repeat,
		              radial-gradient(circle at right bottom, transparent 16rpx, #CE93D8 0, #BA68C8 100%) right bottom / 100% 50% no-repeat;
		  // filter: drop-shadow(-3px 0 3px rgba(0,0,0,.3));
		}
		.l-tickets::after {
		  content: '';
		  position: absolute;
		  height: 100%;
		  width: 8rpx;
		  top: 0;
		  left: -8rpx;
		  background: radial-gradient(circle at left center, transparent 8rpx, #BA68C8 0) left center / 8rpx 20rpx;
		}
		.r-tickets {
			flex: 1;
		  position: relative;
		  background: radial-gradient(circle at left top, transparent 16rpx,  #CE93D8 0,#E1BEE7 100%) right top / 100% 50% no-repeat,
		              radial-gradient(circle at left bottom, transparent 16rpx,  #CE93D8 0,#E1BEE7 100%) right bottom / 100% 50% no-repeat;
		  // filter: drop-shadow(3px 0 3px rgba(0,0,0,.3));
		}
		.r-tickets::before {
		  content: '';
		  width: 1rpx;
		  background: linear-gradient(to top, #fff 0%, #fff 50%, transparent 50%) top left / 1rpx 20rpx repeat-y;
		  position: absolute;
		  left: 0;
		  top: 16rpx;
		  bottom: 16rpx;
		} 
		.r-tickets::after {
		  content: '';
		  position: absolute;
		  height: 100%;
		  width: 8rpx;
		  top: 0;
		  right: -8rpx;
		  background: radial-gradient(circle at right center, transparent 8rpx, #E1BEE7 0) right center / 8rpx 20rpx;
		}
	}
</style>
