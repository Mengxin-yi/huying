<template>
	<view class="example">
		<uni-card style="margin: 0;padding: 0;">
			<uni-forms ref="baseForm" :label-position="alignment">
				<uni-forms-item label="">
					<uni-easyinput disabled v-model="baseFormData.tel" placeholder="" />
					<button class="button" style="margin-left: 10rpx;" size="mini" type="default"
						@click="getcode">{{hintTime ? hintTime + '秒' : '获取验证码'}}</button>
				</uni-forms-item>
				<uni-forms-item label="" >
					<uni-easyinput v-model="baseFormData.code" type="number" placeholder="请输入验证码" />
				</uni-forms-item>
			</uni-forms>
		</uni-card>
		<view class="button-group">
			<button type="primary" size="default" @click="submit()">提交</button>
		</view>
	</view>
</template>

<script>
	import pageUtil from '../../common/js/utils/page.js';
	export default {
		data() {
			return {
				alignment:'left',
				// 基础表单数据
				baseFormData: {
					tel: '',
					code: '',
				},
				hintTime: 0,
			}
		},
		onLoad() {
			this.geinum()
		},
		onReady() {
			// 设置自定义表单校验规则，必须在节点渲染完毕后执行
		},
		methods: {
			geinum() {
				pageUtil.webApi.getMobile({
						_silent: true
					}).then(res => {
						console.log('??', res)
						if (res.tel) {
							this.baseFormData.tel = res.tel
						}
					})
					.catch(err => {
						pageUtil.toast(err);
					});
			},
			getcode() {
				if (this.hintTime) {
					pageUtil.toast('请' + this.hintTime + '秒后重试');
				} else {
					pageUtil.webApi.getUserCode({
							tel: this.baseFormData.tel
						})
						.then(res => {
							pageUtil.toast('短信验证码已发送');
							this.hintTime = 59;
							this.timerSmscode = setInterval(() => {
								if (this.hintTime > 0) {
									this.hintTime = this.hintTime - 1;
								}
								if (this.hintTime < 1) {
									clearInterval(this.timerSmscode);
								}
							}, 1000);
						})
						.catch(err => {
							pageUtil.toast(err);
						});
				}
			},
			submit() {
				if (this.baseFormData.code == '') {
					uni.showToast({
						title: '请输入验证码',
						icon: 'none',
						duration: 2000
					});
				} else {
					pageUtil.webApi.checkMobile({
						code: this.baseFormData.code
					}).then((res) => {
						if (res.status == 200) {
							uni.showToast({
								title: '校验成功',
								icon: 'none',
								duration: 2000,
								success() {
									uni.switchTab({
										url: '/pages/prefer/index'
									});
								}
							});
						}
					}).catch(err => {
						pageUtil.toast(err);
					});
				}
			}
		}
	}
</script>

<style lang="scss" scoped>
	.button-group {
		width: 100%;

		button {
			width: 90%;
			margin: 20rpx auto;
		}
	}
</style>