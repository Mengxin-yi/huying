					<uni-grid-item @click="handlePrefer('prefer/promote/coupon')">
						<view class="grid-item-box" style="background-color: #fff;">
							<uni-icons type="link" :size="30" color="#CE93D8" />
							<text class="text">我的卡券</text>
						</view>
					</uni-grid-item> -->
					<uni-grid-item @click="handlePrefer('prefer/vip/index')">
						<uni-icons type="gift" :size="30" color="#FFC107" />
						<text class="text">会员商城</text>
					</uni-grid-item>
					<uni-grid-item @click="handlePrefer('prefer/vip/bill')">
						<uni-icons type="color" :size="30" color="#4CAF50" />
						<text class="text">我的订单</text>
					</uni-grid-item>
					<uni-grid-item @click="handlePrefer('prefer/vip/inside')">
						<uni-icons type="vip" :size="30" color="#3F51B5" />
						<text class="text">我的会员</text>
					</uni-grid-item>
					<uni-grid-item>
						<uni-icons type="link" :size="30" color="#CE93D8" />
