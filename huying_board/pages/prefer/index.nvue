	<view class="content-inner">
		<view :class="{'header': true, 'weixin': isWeixin}">
			<view class="avatar left-section" style="text-align: center;margin-bottom: 5px;"
				@click="handlePrefera('prefer/user/profile')">
				<image lazy-load="true" v-if="imgStatic.length === 0" src="../../static/image/dash.png" />
				<image lazy-load="true" v-if="imgStatic.length > 0" :src="imgStatic" />
				<span style="font-size: 12px !important;margin-top:3px;">{{entityAuth.check_stat}}</span>
			</view>
			<view class="right-section" style="justify-content: center;">
				<view class="title" style="margin-bottom: 5px;">
					{{username}}
					<!-- 	<view class="mark" v-if="authed">公司认证</view>
					<view class="markb" v-if="entityAuth.check_stat === '审核中'&&entityAuth.user_type=='企事业单位'">审核中</view>
					<view class="markc" v-if="entityAuth.check_stat === '未审核'||entityAuth.check_stat === '审核失败'&&entityAuth.user_type=='企事业单位'">未认证</view> -->
