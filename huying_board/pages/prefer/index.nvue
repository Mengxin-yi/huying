				</uni-grid>
			</view>
		</view>
		<view class="district">
			<view class="subtitle">
				我的分享
				<!-- <view class="media-item-line" style="position: absolute;"></view> -->
			</view>
			<view class="content">
				<uni-grid :column="4" :highlight="true" @change="change">
					<uni-grid-item @click="handlePrefer('publish/list')">
						<uni-icons type="paperplane" :size="30" color="#4CAF50" />
						<text class="text">我的发布</text>
					</uni-grid-item>
					<uni-grid-item @click="handlePrefer('order/list')">

						<uni-icons type="calendar" :size="30" color="#03A9F4" />
