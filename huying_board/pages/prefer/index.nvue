						<view class="levelb">{{entityVip.current_vip_label}}</view>
					</view>
					<view class="vip-info" v-else-if="entityVip.current_vip_label=='流量卡会员'">
						<view class="level">{{entityVip.current_vip_label}}</view>
					</view>
					<view class="vip-info" v-else>
