								</view>
							</view>
						</uni-badge>
					</uni-grid-item>
					<!-- <uni-grid-item v-else @click="handlePrefer('prefer/authentication')"> -->
					<uni-grid-item v-else @click="handlePrefer('prefer/authenticationb')">
						<uni-badge class="uni-badge-left-margin" :is-dot="remindAuthDot" :text="remindAuthLabel"
							absolute="rightTop" size="small">
							<view class="box">
								<view class="box-text">
									<uni-icons type="staff" :size="30" color="#3F51B5" />
									<text class="text">我的认证</text>
								</view>
							</view>
						</uni-badge>
					</uni-grid-item>
					<uni-grid-item v-if="authed" @click="handleNameCard('unit')">

						<uni-icons type="wallet" :size="30" color="#
							FF5722" />
						<text class="text">公司名片</text>

					</uni-grid-item>
					<uni-grid-item v-if="entityProfile.user_type === '个人用户'" @click="handleNameCard('person')">

						<uni-icons type="calendar" :size="30" color="#FF5722" />
