					</view> -->
				</view>
			</view>
		</view>
		<view class="district">
			<view class="subtitle">
				我的服务
				<!-- <view class="media-item-line" style="position: absolute;"></view> -->
			</view>
			<view class="content">
				<uni-grid :showBorder="false" :column="4" :highlight="true" @change="change">

					<!-- <uni-grid-item @click="handlePrefer('prefer/vip/index')">
						<view class="grid-item-box" style="background-color: #fff;">
							<uni-icons type="vip-filled" :size="30" color="#FFC107" />
							<text class="text">我的会员</text>
