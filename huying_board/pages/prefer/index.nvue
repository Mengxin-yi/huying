</template>

<script>
	import pageUtil from '../../common/js/utils/page.js';
	import imgStatic from '../../static/image/echoicon.jpg';

	export default {
		data() {
			return {
				isWeixin: false,
				imgStatic: '',
				username: '',
				entityProfile: {},
				entityAuth: {},
				authed: false,
				entityVip: {},
				remindAuthDot: false,
				remindAuthLabel: ''
			}
		},
		onShow() {
			//处理发布评论
			pageUtil.webApi.getpublishcommentlikenum().then((res) => {
				if (res.status_code == 200) {
					if (res.num > 0) {
						uni.setTabBarBadge({
							index: 3,
							text: res.num + ''
						})
					} else {
						uni.removeTabBarBadge({
							index: 3,
						})
					}
				}
			})
			pageUtil.checkAuthOk('prefer/index');

			// let username = JSON.parse(uni.getStorageSync('profile'))['username']
			// if (username !== '') {
			// 	this.username = username;
			// } else {
			// 	this.username = JSON.parse(uni.getStorageSync('profile'))['tel'];
			// }

			// this.username = uni.getStorageSync('ms_username');
			// console.log('..', JSON.parse(uni.getStorageSync('profile')))
			// if (pageUtil.helper.other.isMobileNumber(this.username)) {
			// 	this.username = pageUtil.helper.other.desensitizePhoneNumber(this.username);
			// }

			this.getData();
		},
		mounted() {
			pageUtil.checkWechatAll();
			this.isWeixin = pageUtil.isWeixin();
			if (this.isWeixin) {
				pageUtil.setNavBarTitle('我的');
			}

		},
		methods: {
			getData() {
				pageUtil.webApi.getProfile({
						_silent: true
					})
					.then(res => {
						this.username = res.item.username ? res.item.username : res.item.tel ? res.item.tel : '';
						this.entityProfile = res.item;
						if (this.entityProfile.avatar_img.length > 0) {
							// this.imgStatic = pageUtil.helper.date.addUrlTimestamp(this.entityProfile.avatar_img);
							this.imgStatic = res.item.avatar_img;
							this.initRemind();
						} else {
							this.imgStatic = '';
						}
					})
					.catch(err => {
						pageUtil.toast(err);
					});

				pageUtil.webApi.getAuthDetail({
						_silent: true
					})
					.then(res => {
						this.entityAuth = res.item;
						this.authed = this.entityAuth.check_stat === '审核通过' && this.entityAuth.user_type == '企事业单位';
						this.initRemind();
					})
					.catch(err => {
						pageUtil.toast(err);
					});

				pageUtil.webApi.getUserVip({
						_silent: true
					})
					.then(res => {
						this.entityVip = res.item;
						// this.entityVip.vip_level = 1;
						// this.entityVip.due_time = '2025-01-01';
					})
					.catch(err => {
						pageUtil.toast(err);
					});
			},
			change(e) {
				console.log(e.detail.index);
			},
			handlePrefer(page) {
				pageUtil.gotoPage(page);
			},
			handlePrefera(page) {
				uni.navigateTo({
					url: '/pages/prefer/user/profile'
				})
			},
			handleNameCard(type) {
				pageUtil.gotoPage('prefer/namecard' + '?data=' + JSON.stringify({
					type: type
				}));
			},
			initRemind() {
				this.remindAuthDot = this.entityProfile.user_type !== '个人用户' && (!this.entityAuth.name || this.entityAuth
					.check_stat === '审核失败');
				this.remindAuthLabel = this.entityProfile.user_type !== '个人用户' && (!this.entityAuth.name || this.entityAuth
					.check_stat === '审核失败') ? '1' : '';
				// this.remindAuthDot = this.entityProfile.user_type !== '个人用户' && !this.authed;
				// this.remindAuthLabel = this.entityProfile.user_type !== '个人用户' && !this.authed ? '1' : '';
			}
		}
	}
</script>

